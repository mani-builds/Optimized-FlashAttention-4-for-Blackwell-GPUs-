ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=flash_pytorch_extension -DTORCH_API_INCLUDE_EXTENSION_H -I/home/mani/miniconda3/envs/pytorch/lib/python3.12/site-packages/pybind11/include -isystem /home/mani/miniconda3/envs/pytorch/lib/python3.12/site-packages/torch/include -isystem /home/mani/miniconda3/envs/pytorch/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /home/mani/miniconda3/envs/pytorch/include/python3.12 -fPIC -std=c++17 -O3 -g
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=flash_pytorch_extension -DTORCH_API_INCLUDE_EXTENSION_H -I/home/mani/miniconda3/envs/pytorch/lib/python3.12/site-packages/pybind11/include -isystem /home/mani/miniconda3/envs/pytorch/lib/python3.12/site-packages/torch/include -isystem /home/mani/miniconda3/envs/pytorch/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /home/mani/miniconda3/envs/pytorch/include/python3.12 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_89,code=compute_89 -gencode=arch=compute_89,code=sm_89 --compiler-options '-fPIC' -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/mani/miniconda3/envs/pytorch/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build flash_v2_mma.cuda.o: cuda_compile /home/mani/gpu/flash_attention_project/flash_v2_mma.cu





build flash_pytorch_extension.so: link flash_v2_mma.cuda.o

default flash_pytorch_extension.so
